{
  "buildCommand": "echo skip-build",
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/platform",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/impact",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/faqs",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/learn",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/join-us",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/why-we-exist",
      "destination": "/meet-the-team",
      "permanent": true
    },
    {
      "source": "/customers",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/meet-the-team",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/meet-the-team",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/chapter-one",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/chapter-two",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
